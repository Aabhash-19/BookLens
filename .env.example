# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=booklens
POSTGRES_PASSWORD=booklens_secret
POSTGRES_DB=booklens
DATABASE_URL=postgresql+asyncpg://booklens:booklens_secret@localhost:5432/booklens
DATABASE_URL_SYNC=postgresql://booklens:booklens_secret@localhost:5432/booklens

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / Object Storage ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET_NAME=book-scans
MINIO_SECURE=false

# ─── Authentication (JWT) ─────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# ─── External Book APIs ───────────────────────────────────────────────────────
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
# Optional: Get a free key at https://console.cloud.google.com → Books API
GOOGLE_BOOKS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BookLens
